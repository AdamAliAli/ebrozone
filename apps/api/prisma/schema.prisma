generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMINISTRATOR
}

model User {
  id              String      @id @default(uuid(7)) @db.Uuid
  email           String      @unique
  passwordHash    String?
  role            Role
  emailVerifiedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  authTokens        AuthToken[]
  refreshTokens     RefreshToken[]
  courseEnrollments CourseEnrollment[]
  bookingsAsStudent Booking[]          @relation("BookingStudent")
  bookingsAsTeacher Booking[]          @relation("BookingTeacher")
  lessonsAsStudent  Lesson[]           @relation("LessonStudent")
  lessonsAsTeacher  Lesson[]           @relation("LessonTeacher")
  messagesSent      Message[]          @relation("MessageSender")
  messagesReceived  Message[]          @relation("MessageRecipient")

  @@index([role])
  @@map("users")
}

enum AuthTokenType {
  ACTIVATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @db.Uuid
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Course {
  id          String    @id @default(uuid(7)) @db.Uuid
  title       String
  description String?
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  courseEnrollments CourseEnrollment[]
  lessons           Lesson[]

  @@map("courses")
}

model CourseEnrollment {
  id         String    @id @default(uuid(7)) @db.Uuid
  studentId  String    @db.Uuid
  courseId   String    @db.Uuid
  enrolledAt DateTime  @default(now())
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  student    User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("course_enrollments")
}

enum ConsultationRequestStatus {
  PENDING
  CONTACTED
  CONVERTED
  DECLINED
}

model ConsultationRequest {
  id                   String                    @id @default(uuid(7)) @db.Uuid
  fullName             String
  phone                String
  email                String?
  preferredContactTime String?
  currentEnglishLevel  String?
  learningGoal         String?
  notes                String?
  status               ConsultationRequestStatus @default(PENDING)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([status])
  @@map("consultation_requests")
}

enum BookingType {
  FREE_CONSULTATION
  LIVE_CLASS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model Booking {
  id          String        @id @default(uuid(7)) @db.Uuid
  studentId   String        @db.Uuid
  teacherId   String        @db.Uuid
  type        BookingType
  scheduledAt DateTime
  status      BookingStatus @default(PENDING)
  meetingLink String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  student     User          @relation("BookingStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher     User          @relation("BookingTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  lesson      Lesson?

  @@index([studentId])
  @@index([teacherId])
  @@index([status])
  @@map("bookings")
}

enum LessonStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model Lesson {
  id         String       @id @default(uuid(7)) @db.Uuid
  title      String
  studentId  String       @db.Uuid
  teacherId  String       @db.Uuid
  bookingId  String       @db.Uuid @unique
  courseId   String       @db.Uuid
  lessonDate DateTime
  status     LessonStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  student    User         @relation("LessonStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher    User         @relation("LessonTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  homeworks  Homework[]

  @@index([studentId])
  @@index([teacherId])
  @@index([courseId])
  @@index([status])
  @@map("lessons")
}

enum HomeworkSubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  REVIEWED
}

model Homework {
  id               String                   @id @default(uuid(7)) @db.Uuid
  lessonId         String                   @db.Uuid
  instructions     String
  dueDate          DateTime
  submissionStatus HomeworkSubmissionStatus @default(NOT_SUBMITTED)
  teacherFeedback  String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  lesson           Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([submissionStatus])
  @@map("homeworks")
}

model Message {
  id          String    @id @default(uuid(7)) @db.Uuid
  senderId    String    @db.Uuid
  recipientId String    @db.Uuid
  body        String
  readAt      DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
  @@map("messages")
}
