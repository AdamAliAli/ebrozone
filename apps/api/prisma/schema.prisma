generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMINISTRATOR
}

model User {
  id              String      @id @default(uuid(7)) @db.Uuid
  email           String      @unique
  passwordHash    String?
  role            Role
  emailVerifiedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  authTokens      AuthToken[]
  refreshTokens   RefreshToken[]

  @@index([role])
  @@map("users")
}

enum AuthTokenType {
  ACTIVATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @db.Uuid
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
